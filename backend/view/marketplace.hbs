<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>ArtAround – Area Docente</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container mt-5">
        <h1 class="text-primary">Dashboard Marketplace</h1>
        <p class="lead">Benvenuto, <strong>{{utente}}</strong>. Qui puoi gestire le visite per i tuoi studenti.</p>

        {{#if errore}}
            <div class="alert alert-danger">{{errore}}</div>
        {{/if}}

        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Museo</th>
                            <th>Città</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each musei}}
                        <tr>
                            <td><strong>{{this.nome}}</strong></td>
                            <td>{{this.citta}}</td>
                            <td class="text-end">
                                <a href="/configura/{{this._id}}" class="btn btn-success">
                                    Seleziona Museo
                                </a>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                Nessun museo trovato nel database.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>